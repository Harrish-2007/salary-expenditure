# Copy this file to ".env" for local notes. NEVER commit the real values.
# On Vercel, add these in: Project -> Settings -> Environment Variables.

# A long random text. Create one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-a-long-random-value-here

# PostgreSQL connection string from Neon / Supabase (use the "pooled" one on Vercel).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
